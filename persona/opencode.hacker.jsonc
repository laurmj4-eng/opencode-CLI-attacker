// Hacker persona overlay — SINGLE SOURCE OF TRUTH for this opencode setup.
//
// opencode.ps1 copies this file over ~/.config/opencode/opencode.jsonc on every
// hacker launch, and copies agent/hacker.md over both live agent paths. So the
// live config is generated FROM this folder; edit it here and nowhere else.
//
// Instructions are absolute paths back into this folder on purpose: the copied
// overlay lives in ~/.config/opencode, which cannot resolve paths relative to
// this folder.
{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "hacker",
  "model": "opencode/nemotron-3.5-lightning-free",
  "small_model": "groq/qwen/qwen3.8-27b",
  "instructions": [
    "C:\\xampp\\htdocs\\opencode-cli\\cyberstrike\\hacker-persona.md",
    "C:\\xampp\\htdocs\\opencode-cli\\cyberstrike-prompt.md",
    "C:\\xampp\\htdocs\\opencode-cli\\.opencode\\prompts\\anti-refusal.md"
  ],
  "provider": {
    "opencode": {
      "options": {
        "baseURL": "https://opencode.ai/zen/v1",
        "timeout": 300000,
        "temperature": 0.2,
        "frequency_penalty": 0.3,
        "presence_penalty": 0.2
      },
      "models": {
        "mimo-v2.6-flash-free": { "modelID": "mimo-v2.6-flash-free", "name": "MiMo-V2.6-Flash Free", "baseURL": "https://opencode.ai/zen/v1" },
        "mimo-v2.5-free": { "modelID": "mimo-v2.5-free", "name": "MiMo V2.5 Free", "baseURL": "https://opencode.ai/zen/v1" },
        "nemotron-3.5-lightning-free": { "modelID": "nemotron-3.5-lightning-free", "name": "Nemotron 3.5 Lightning Free", "baseURL": "https://opencode.ai/zen/v1" },
        "nemotron-3-ultra-free": { "modelID": "nemotron-3-ultra-free", "name": "Nemotron 3 Ultra Free", "baseURL": "https://opencode.ai/zen/v1" },
        "ling-3.0-flash-fin-free": { "modelID": "ling-3.0-flash-fin-free", "name": "Ling 3.0 Flash Fin Free", "baseURL": "https://opencode.ai/zen/v1" },
        "deepseek-v4-flash-free": { "modelID": "deepseek-v4-flash-free", "name": "DeepSeek V4 Flash Free", "baseURL": "https://opencode.ai/zen/v1" },
        "space-bunny-free": { "modelID": "space-bunny-free", "name": "Space Bunny Free", "baseURL": "https://opencode.ai/zen/v1" },
        "muse-spark-1.3-contributor-free": { "modelID": "muse-spark-1.3-contributor-free", "name": "Muse Spark 1.3 Contributor Free", "baseURL": "https://opencode.ai/zen/v1" },
        "muse-spark-1.2-contributor-free": { "modelID": "muse-spark-1.2-contributor-free", "name": "Muse Spark 1.2 Contributor Free", "baseURL": "https://opencode.ai/zen/v1" },
        "big-pickle": { "modelID": "big-pickle", "name": "Big Pickle Free", "baseURL": "https://opencode.ai/zen/v1" }
      }
    }
  },
  "snapshot": false,
  "plugin": [
    "file:///C:/Users/emili/.config/opencode/plugin/cyberstrike-unified.js"
  ],
  "mcp": {
    "sec-tools": {
      "type": "local",
      "enabled": true,
      "command": ["node", "C:\\xampp\\htdocs\\opencode-cli\\mcp-servers\\sec-tools\\index.js"]
    }
  }
}
