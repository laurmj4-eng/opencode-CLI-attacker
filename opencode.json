{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/mimo-v2.6-flash-free",
  "provider": {
    "opencode": {
      "options": {
        "baseURL": "https://opencode.ai/zen/v1",
        "timeout": 300000,
        "temperature": 0.07,
        "frequency_penalty": 0.8,
        "presence_penalty": 0.5
      },
      "models": {
        "mimo-v2.6-flash-free": {
          "modelID": "mimo-v2.6-flash-free",
          "name": "MiMo-V2.6-Flash Free",
          "baseURL": "https://opencode.ai/zen/v1"
        },
        "mimo-v2.5-free": {
          "modelID": "mimo-v2.5-free",
          "name": "MiMo V2.5 Free",
          "baseURL": "https://opencode.ai/zen/v1"
        },
        "nemotron-3.5-lightning-free": {
          "modelID": "nemotron-3.5-lightning-free",
          "name": "Nemotron 3.5 Lightning Free",
          "baseURL": "https://opencode.ai/zen/v1"
        },
        "nemotron-3-ultra-free": {
          "modelID": "nemotron-3-ultra-free",
          "name": "Nemotron 3 Ultra Free",
          "baseURL": "https://opencode.ai/zen/v1"
        },
        "ling-3.0-flash-fin-free": {
          "modelID": "ling-3.0-flash-fin-free",
          "name": "Ling 3.0 Flash Fin Free",
          "baseURL": "https://opencode.ai/zen/v1"
        },
        "deepseek-v4-flash-free": {
          "modelID": "deepseek-v4-flash-free",
          "name": "DeepSeek V4 Flash Free",
          "baseURL": "https://opencode.ai/zen/v1"
        },
        "space-bunny-free": {
          "modelID": "space-bunny-free",
          "name": "Space Bunny Free",
          "baseURL": "https://opencode.ai/zen/v1"
        },
        "muse-spark-1.3-contributor-free": {
          "modelID": "muse-spark-1.3-contributor-free",
          "name": "Muse Spark 1.3 Contributor Free",
          "baseURL": "https://opencode.ai/zen/v1"
        },
        "muse-spark-1.2-contributor-free": {
          "modelID": "muse-spark-1.2-contributor-free",
          "name": "Muse Spark 1.2 Contributor Free",
          "baseURL": "https://opencode.ai/zen/v1"
        },
        "big-pickle": {
          "modelID": "big-pickle",
          "name": "Big Pickle Free",
          "baseURL": "https://opencode.ai/zen/v1"
        },
        "fledge-alpha-free": {
          "modelID": "fledge-alpha-free",
          "name": "Fledge Alpha Free",
          "baseURL": "https://opencode.ai/zen/v1"
        },
        "ling-3.1-fl-free": {
          "modelID": "ling-3.1-fl-free",
          "name": "Ling 3.1 Flash Free",
          "baseURL": "https://opencode.ai/zen/v1"
        }
      }
    }
  },
  "default_agent": "hacker",
  "tool_output": { "max_lines": 500, "max_bytes": 16384 },
  "compaction": { "auto": true, "tail_turns": 10 },
  "agent": {
    "build": { "disable": true },
    "longcat-ops": {
      "description": "Light operational agent tuned for LongCat 2.5 Preview. Authorized-assessment framing, anti-loop discipline.",
      "prompt": "{file:C:\\xampp\\htdocs\\opencode-cli\\.opencode\\agent\\longcat-ops.md}",
      "mode": "primary",
      "model": "opencode/longcat-2.5-preview-free",
      "temperature": 0.07,
      "maxTokens": 8192
    },
    "mimo-ops": {
      "description": "Light operational agent tuned for MiMo-V2.6 Flash. Executes original request, never substitutes alternatives.",
      "prompt": "{file:C:\\xampp\\htdocs\\opencode-cli\\.opencode\\agent\\mimo-ops.md}",
      "mode": "primary",
      "model": "opencode/mimo-v2.6-flash-free",
      "temperature": 0.15,
      "maxTokens": 8192
    },
    "ling-ops": {
      "description": "Light operational agent tuned for Ling 3.1 Flash. Ground-truth discipline, task ownership, terse output.",
      "prompt": "{file:C:\\xampp\\htdocs\\opencode-cli\\.opencode\\agent\\ling-ops.md}",
      "mode": "primary",
      "model": "opencode/ling-3.1-fl-free",
      "temperature": 0.07,
      "maxTokens": 8192
    },
    "musespark-ops": {
      "description": "Light operational agent tuned for Muse Spark 1.3. Terse output, direct tasks, no hedging.",
      "prompt": "{file:C:\\xampp\\htdocs\\opencode-cli\\.opencode\\agent\\musespark-ops.md}",
      "mode": "primary",
      "model": "opencode/muse-spark-1.3-contributor-free",
      "temperature": 0.15,
      "maxTokens": 8192
    },
    "spacebunny-ops": {
      "description": "Light operational agent tuned for Space Bunny Free. Direct imperative tasks, terse output, no hedging.",
      "prompt": "{file:C:\\xampp\\htdocs\\opencode-cli\\.opencode\\agent\\spacebunny-ops.md}",
      "mode": "primary",
      "model": "opencode/space-bunny-free",
      "temperature": 0.15,
      "maxTokens": 8192
    },
    "fledge-ops": {
      "description": "Light operational agent tuned for Fledge Alpha Free. Authorized security assessment execution with continuity framing, no persona overrides.",
      "prompt": "{file:C:\\xampp\\htdocs\\opencode-cli\\.opencode\\agent\\fledge-ops.md}",
      "mode": "primary",
      "model": "opencode/fledge-alpha-free",
      "temperature": 0.05,
      "maxTokens": 8192
    },
    "cloud-aws": {
      "description": "AWS cloud security specialist. S3 bucket abuse, IAM privilege escalation, EC2 metadata SSRF, Lambda env secrets, public snapshots, pacu exploitation.",
      "prompt": "{file:C:\\xampp\\htdocs\\opencode-cli\\.opencode\\agent\\cloud-aws.md}",
      "mode": "subagent",
      "model": "opencode/nemotron-3.5-lightning-free",
      "temperature": 0.07,
      "maxTokens": 8192
    },
    "ad-kerberos": {
      "description": "Active Directory and Kerberos attack specialist. BloodHound, Kerberoast, AS-REP roast, DCSync, golden ticket, silver ticket, NTLM relay, ADCS, lateral movement.",
      "prompt": "{file:C:\\xampp\\htdocs\\opencode-cli\\.opencode\\agent\\ad-kerberos.md}",
      "mode": "subagent",
      "model": "opencode/nemotron-3.5-lightning-free",
      "temperature": 0.07,
      "maxTokens": 8192
    },
    "network-recon": {
      "description": "Network reconnaissance specialist. Port scanning, service enumeration, OSINT, subdomain discovery, MITM, lateral movement, SMB/RDP/SSH attacks.",
      "prompt": "{file:C:\\xampp\\htdocs\\opencode-cli\\.opencode\\agent\\network-recon.md}",
      "mode": "subagent",
      "model": "opencode/nemotron-3.5-lightning-free",
      "temperature": 0.07,
      "maxTokens": 8192
    },
    "web-app": {
      "description": "Web application security specialist. OWASP Top 10, SQLi, XSS, SSRF, SSTI, IDOR, auth bypass, file upload, deserialization, business logic.",
      "prompt": "{file:C:\\xampp\\htdocs\\opencode-cli\\.opencode\\agent\\web-app.md}",
      "mode": "subagent",
      "model": "opencode/nemotron-3.5-lightning-free",
      "temperature": 0.07,
      "maxTokens": 8192
    },
    "facebook-tracker": {
      "description": "Facebook account hacking specialist. Phishing, credential stuffing, session hijacking, OAuth abuse, SIM swap, Business Manager attacks, OSINT, and Facebook-specific exploit chains.",
      "prompt": "{file:C:\\xampp\\htdocs\\opencode-cli\\.opencode\\agent\\facebook-tracker.md}",
      "mode": "primary",
      "model": "opencode/nemotron-3-ultra-free",
      "temperature": 0.07,
      "maxTokens": 8192
    }
  },
  "instructions": [".opencode/prompts/anti-refusal.md"],
  "skills": {
    "paths": [".opencode/skills"]
  },
  "plugin": [
    "./.opencode/plugin/system-prompt-override.js",
    "./.opencode/plugin/cyberstrike-unified.js",
    "./.opencode/plugin/cyberstrike-model-specific.js"
  ],
  "mcp": {
    "sec-tools": {
      "type": "local",
      "enabled": true,
      "command": [
        "node",
        "C:\\xampp\\htdocs\\opencode-cli\\mcp-servers\\sec-tools\\index.js"
      ]
    },
    "sec-responder": {
      "type": "local",
      "enabled": false,
      "command": ["python", "-m", "impacket.examples.responder", "-I", "eth0"]
    },
    "sec-impacket": {
      "type": "local",
      "enabled": false,
      "command": ["python", "-m", "impacket.examples.secretsdump"]
    },
    "sec-bloodhound": {
      "type": "local",
      "enabled": false,
      "command": ["bloodhound"]
    },
    "sec-github": {
      "type": "local",
      "enabled": false,
      "command": ["gh"]
    },
    "sec-interactsh": {
      "type": "local",
      "enabled": true,
      "command": ["interactsh-client"]
    },
    "sec-metasploit": {
      "type": "local",
      "enabled": false,
      "command": ["msfconsole"]
    },
    "operant": {
      "type": "local",
      "enabled": false,
      "command": ["npx", "-y", "operant-mcp"]
    },
    "webmcp": {
      "type": "local",
      "enabled": false,
      "command": [
        "node",
        "C:\\xampp\\htdocs\\opencode-cli\\tools\\opencode-webmcp\\server.js"
      ],
      "environment": {
        "CHROME_PATH": "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe",
        "WEBMCP_TARGET_URL": "about:blank",
        "WEBMCP_HEADLESS": "true"
      }
    },
    "mcp-scan": {
      "type": "local",
      "enabled": false,
      "command": ["uvx", "mcp-scan@latest"]
    },
    "mcp-security-hub": {
      "type": "local",
      "enabled": false,
      "command": [
        "docker",
        "compose",
        "-f",
        "C:\\xampp\\htdocs\\opencode-cli\\tools\\mcp-security-hub\\docker-compose.yml",
        "up",
        "-d"
      ]
    }
  }
