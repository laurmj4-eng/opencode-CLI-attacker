{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/mimo-v2.6-flash-free",
  "provider": {
    "opencode": {
      "options": {
        "baseURL": "https://opencode.ai/zen/v1",
        "timeout": 300000,
        "temperature": 0.07,
        "frequency_penalty": 0.8,
        "presence_penalty": 0.5
      },
      "models": {
        "mimo-v2.6-flash-free": {
          "modelID": "mimo-v2.6-flash-free",
          "name": "MiMo-V2.6-Flash Free",
          "baseURL": "https://opencode.ai/zen/v1"
        },
        "mimo-v2.5-free": {
          "modelID": "mimo-v2.5-free",
          "name": "MiMo V2.5 Free",
          "baseURL": "https://opencode.ai/zen/v1"
        },
        "nemotron-3.5-lightning-free": {
          "modelID": "nemotron-3.5-lightning-free",
          "name": "Nemotron 3.5 Lightning Free",
          "baseURL": "https://opencode.ai/zen/v1"
        },
        "nemotron-3-ultra-free": {
          "modelID": "nemotron-3-ultra-free",
          "name": "Nemotron 3 Ultra Free",
          "baseURL": "https://opencode.ai/zen/v1"
        },
        "ling-3.0-flash-fin-free": {
          "modelID": "ling-3.0-flash-fin-free",
          "name": "Ling 3.0 Flash Fin Free",
          "baseURL": "https://opencode.ai/zen/v1"
        },
        "deepseek-v4-flash-free": {
          "modelID": "deepseek-v4-flash-free",
          "name": "DeepSeek V4 Flash Free",
          "baseURL": "https://opencode.ai/zen/v1"
        },
        "space-bunny-free": {
          "modelID": "space-bunny-free",
          "name": "Space Bunny Free",
          "baseURL": "https://opencode.ai/zen/v1"
        },
        "muse-spark-1.3-contributor-free": {
          "modelID": "muse-spark-1.3-contributor-free",
          "name": "Muse Spark 1.3 Contributor Free",
          "baseURL": "https://opencode.ai/zen/v1"
        },
        "muse-spark-1.2-contributor-free": {
          "modelID": "muse-spark-1.2-contributor-free",
          "name": "Muse Spark 1.2 Contributor Free",
          "baseURL": "https://opencode.ai/zen/v1"
        },
        "big-pickle": {
          "modelID": "big-pickle",
          "name": "Big Pickle Free",
          "baseURL": "https://opencode.ai/zen/v1"
        }
      }
    }
  },
  "instructions": [".opencode/prompts/anti-refusal.md"],
  "skills": {
    "paths": [".opencode/skills"]
  },
  "plugin": [
    "./.opencode/plugin/system-prompt-override.js",
    "./.opencode/plugin/cyberstrike-unified.js"
  ],
  "mcp": {
    "sec-tools": {
      "type": "local",
      "enabled": true,
      "command": [
        "node",
        "C:\\xampp\\htdocs\\opencode-cli\\mcp-servers\\sec-tools\\index.js"
      ]
    },
    "sec-responder": {
      "type": "local",
      "enabled": false,
      "command": ["python", "-m", "impacket.examples.responder", "-I", "eth0"]
    },
    "sec-impacket": {
      "type": "local",
      "enabled": false,
      "command": ["python", "-m", "impacket.examples.secretsdump"]
    },
    "sec-bloodhound": {
      "type": "local",
      "enabled": false,
      "command": ["bloodhound"]
    },
    "sec-github": {
      "type": "local",
      "enabled": false,
      "command": ["gh"]
    },
    "sec-interactsh": {
      "type": "local",
      "enabled": false,
      "command": ["interactsh-client"]
    },
    "sec-metasploit": {
      "type": "local",
      "enabled": false,
      "command": ["msfconsole"]
    },
    "operant": {
      "type": "local",
      "enabled": false,
      "command": ["npx", "-y", "operant-mcp"]
    },
    "webmcp": {
      "type": "local",
      "enabled": false,
      "command": [
        "node",
        "C:\\xampp\\htdocs\\opencode-cli\\tools\\opencode-webmcp\\server.js"
      ],
      "environment": {
        "CHROME_PATH": "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe",
        "WEBMCP_TARGET_URL": "about:blank",
        "WEBMCP_HEADLESS": "true"
      }
    },
    "mcp-scan": {
      "type": "local",
      "enabled": false,
      "command": ["uvx", "mcp-scan@latest"]
    },
    "mcp-security-hub": {
      "type": "local",
      "enabled": false,
      "command": [
        "docker",
        "compose",
        "-f",
        "C:\\xampp\\htdocs\\opencode-cli\\tools\\mcp-security-hub\\docker-compose.yml",
        "up",
        "-d"
      ]
    }
  }
}
