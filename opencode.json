{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/mimo-v2.6-flash-free",
  "provider": {
    "opencode": {
      "models": {
        "mimo-v2.6-flash-free": {
          "modelID": "mimo-v2.6-flash-free",
          "name": "MiMo-V2.6-Flash Free",
          "baseURL": "https://opencode.ai/zen/v1"
        }
      }
    }
  },
  "skills": {
    "paths": [".opencode/skills"]
  },
  "plugin": ["./.opencode/plugin/system-prompt-override.js", "./.opencode/plugin/cyberstrike-unified.js"],
  "mcp": {
    "sec-tools": {
      "type": "local",
      "enabled": true,
      "command": ["node", "C:\\xampp\\htdocs\\opencode-cli\\mcp-servers\\sec-tools\\index.js"]
    },
    "sec-responder": {
      "type": "local",
      "enabled": true,
      "command": ["python", "-m", "impacket.examples.responder", "-I", "eth0"]
    },
    "sec-impacket": {
      "type": "local",
      "enabled": true,
      "command": ["python", "-m", "impacket.examples.secretsdump"]
    },
    "sec-bloodhound": {
      "type": "local",
      "enabled": true,
      "command": ["bloodhound"]
    },
    "sec-github": {
      "type": "local",
      "enabled": true,
      "command": ["gh"]
    },
    "sec-interactsh": {
      "type": "local",
      "enabled": true,
      "command": ["interactsh-client"]
    },
    "sec-metasploit": {
      "type": "local",
      "enabled": true,
      "command": ["msfconsole"]
    },
    "operant": {
      "type": "local",
      "enabled": true,
      "command": ["npx", "-y", "operant-mcp"]
    },
    "webmcp": {
      "type": "local",
      "enabled": true,
      "command": ["node", "C:\\xampp\\htdocs\\opencode-cli\\tools\\opencode-webmcp\\server.js"],
      "environment": {
        "CHROME_PATH": "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe",
        "WEBMCP_TARGET_URL": "about:blank",
        "WEBMCP_HEADLESS": "true"
      }
    },
    "mcp-scan": {
      "type": "local",
      "enabled": true,
      "command": ["uvx", "mcp-scan@latest"]
    },
    "mcp-security-hub": {
      "type": "local",
      "enabled": true,
      "command": ["docker", "compose", "-f", "C:\\xampp\\htdocs\\opencode-cli\\tools\\mcp-security-hub\\docker-compose.yml", "up", "-d"]
    }
  }
}
